{
  "name": "raqeem-os",
  "version": "0.1.0",
  "description": "نظام إدارة مطابع - يعمل محليًا بالكامل",
  "private": true,
  "main": "electron/main.js",
  "author": "RaqeemOS",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node server/index.js",
    "dev": "concurrently -k -n SERVER,CLIENT -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:electron": "cross-env RAQEEM_ENV=dev electron .",
    "seed:test": "node server/db/seed-test.js",
    "build:client": "npm --prefix client run build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build:client && electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.raqeemos.app",
    "productName": "RaqeemOS",
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
